# ==============================================================================
# Пример конфигурации Nginx для хостинга KCLC Church Platform на VPS
# Путь в Ubuntu/Debian: /etc/nginx/sites-available/kclc.conf
# ==============================================================================

# 1. Перенаправление с HTTP на HTTPS
server {
    listen 80;
    listen [::]:80;
    server_name kclc.ru www.kclc.ru;

    # Для Let's Encrypt Certbot
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

# 2. Основной защищенный сервер HTTPS
server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name kclc.ru www.kclc.ru;

    # SSL сертификаты (от certbot --nginx)
    ssl_certificate /etc/letsencrypt/live/kclc.ru/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/kclc.ru/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    # Максимальный размер загружаемых файлов (видео, фото, чеки)
    client_max_body_size 50M;

    # Сжатие GZip
    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_proxied any;
    gzip_types text/plain text/css text/xml application/javascript application/json image/svg+xml;

    # Раздача статических файлов (WhiteNoise также кеширует их)
    location /static/ {
        alias /var/www/kclc/staticfiles/;
        expires 365d;
        access_log off;
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    # Раздача медиа файлов
    location /media/ {
        alias /var/www/kclc/media/;
        expires 30d;
        access_log off;
        add_header Cache-Control "public, max-age=2592000";
    }

    # Проксирование всех запросов в Gunicorn
    location / {
        proxy_pass http://127.0.0.1:8000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_redirect off;

        # WebSocket / Server-Sent Events поддержка при необходимости
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";

        proxy_connect_timeout 120s;
        proxy_read_timeout 120s;
    }
}

