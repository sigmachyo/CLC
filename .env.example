# ==============================================================================
# KCLC Church Platform — Production Environment Variables (.env)
# Скопируйте этот файл в .env и заполните боевые значения для хостинга
# ==============================================================================

# ── Django Core Settings ──────────────────────────────────────────────────────
# Секретный ключ Django (ОБЯЗАТЕЛЬНО сгенерируйте уникальный длинный ключ для продакшена!)
# Например, с помощью: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=generate-your-production-secret-key-here-min-50-chars

# Режим отладки: False для продакшена! True ТОЛЬКО для локальной разработки
DJANGO_DEBUG=False

# Разрешенные домены (через запятую, без пробелов и протоколов)
# Например: kclc.ru,www.kclc.ru,kclc-app.onrender.com,127.0.0.1
DJANGO_ALLOWED_HOSTS=kclc.ru,www.kclc.ru,localhost,127.0.0.1

# Доверенные источники для защиты CSRF (домены, с которых отправляются POST-формы)
# Например: https://kclc.ru,https://www.kclc.ru,https://kclc-app.onrender.com
CSRF_TRUSTED_ORIGINS=https://kclc.ru,https://www.kclc.ru

# ── База данных (PostgreSQL в продакшене) ──────────────────────────────────────
# Формат: postgresql://USER:PASSWORD@HOST:PORT/NAME
# Если переменная не указана, проект автоматически использует локальную SQLite базу
DATABASE_URL=postgresql://kclc_user:kclc_secure_password@localhost:5432/kclc_db

# ── Безопасность и SSL / HTTPS ────────────────────────────────────────────────
# Включите True, если сайт работает по HTTPS (рекомендуется для продакшена)
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_HSTS_SECONDS=31536000

# ── Email рассылки (SMTP mail.ru или Yandex / Google) ────────────────────────
EMAIL_HOST=smtp.mail.ru
EMAIL_PORT=465
EMAIL_USE_SSL=True
EMAIL_USE_TLS=False
EMAIL_HOST_USER=bot.kclc@mail.ru
# Пароль для внешних приложений (сгенерированный в настройках безопасности почты Mail.ru)
EMAIL_HOST_PASSWORD=your_mail_ru_app_password
DEFAULT_FROM_EMAIL=KCLC <bot.kclc@mail.ru>

# ── Web Push Уведомления (VAPID) ──────────────────────────────────────────────
VAPID_PUBLIC_KEY=BPWzM8Sg21koEirpUOKjfqqqUeOL6c4PrF3KwT32QYT9pQP6R1Da9u8jSS0UMTkx4DL_75iOadzTAPNSOJVGlpo
VAPID_PRIVATE_KEY=a4IVr9jA_SyFG-cohYOfztaM0Ul3xrXZI8qgl6a_KKk
VAPID_ADMIN_EMAIL=mailto:bot.kclc@mail.ru

# ── Авторизация через социальные сети (OAuth) ─────────────────────────────────
# VK OAuth (https://id.vk.com/about/business/go)
VK_CLIENT_ID=
VK_CLIENT_SECRET=

# Яндекс OAuth (https://oauth.yandex.ru/)
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=

# ── Защита от спама (hCaptcha) ────────────────────────────────────────────────
# Бесплатные ключи на https://www.hcaptcha.com/
# (По умолчанию указаны тестовые ключи, которые всегда успешно проходят валидацию)
HCAPTCHA_SITEKEY=10000000-ffff-ffff-ffff-000000000001
HCAPTCHA_SECRET=0x0000000000000000000000000000000000000000

# ── Уровень логирования (DEBUG, INFO, WARNING, ERROR) ─────────────────────────
DJANGO_LOG_LEVEL=INFO
